local function WMCC_fake_script() -- TextButton.LocalScript 
	local script = Instance.new('LocalScript', TextButton)

	local TweenService = game:GetService("TweenService")
	local player = game.Players.LocalPlayer
	local button = script.Parent 
	
	local isRunning = false
	local character = player.Character or player.CharacterAdded:Wait()
	local rootPart = character:WaitForChild("HumanoidRootPart")
	
	player.CharacterAdded:Connect(function(newChar)
		character = newChar
		rootPart = newChar:WaitForChild("HumanoidRootPart")
	end)
	
	local function smoothMove(targetPos, duration)
		if not isRunning then return end 
	
		local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		local tween = TweenService:Create(rootPart, info, {CFrame = CFrame.new(targetPos)})
		tween:Play()
		tween.Completed:Wait()
	end
	
	local function runSequence()
		while isRunning do
			if not isRunning then break end
			rootPart.CFrame = CFrame.new(-50, 372, 193)
			rootPart.Anchored = true
			task.wait(3)
			rootPart.Anchored = false
	
			smoothMove(Vector3.new(-53, 66, 1279), 0.7)
	
			smoothMove(Vector3.new(-85, 74, 2439), 10)
	
			if not isRunning then break end
			rootPart.Anchored = true
			task.wait(2)
			rootPart.Anchored = false
	
			if not isRunning then break end
			rootPart.CFrame = CFrame.new(-54, 121, 7666)
			rootPart.Anchored = true
			task.wait(1)
			rootPart.Anchored = false
	
			smoothMove(Vector3.new(-50, 90, 8700), 0.7)
			if not isRunning then break end
			rootPart.Anchored = true 
			task.wait(1)
			rootPart.Anchored = false
	
			smoothMove(Vector3.new(-50, -184, 8813), 0.7)
	
			smoothMove(Vector3.new(-52, -294, 9490), 0.7)
	
			if not isRunning then break end
			rootPart.Anchored = false
	
			-- Final delay set to 20 seconds
			task.wait(20)
		end
	end
	
	button.MouseButton1Click:Connect(function()
		isRunning = not isRunning 
	
		if isRunning then
			button.Text = "Auto Farm ON" 
			task.spawn(runSequence)
		else
			button.Text = "Auto Farm Off"
			rootPart.Anchored = false
		end
	end)
end
coroutine.wrap(WMCC_fake_script)()

local function RXMTEB_fake_script() -- Frame.Draggable 
	local script = Instance.new('LocalScript', Frame)

	local UIS = game:GetService("UserInputService")
	local f = script.Parent
	local d, s, p
	
	f.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			d, s, p = true, i.Position, f.Position
		end
	end)
	
	UIS.InputChanged:Connect(function(i)
		if d and i.UserInputType == Enum.UserInputType.MouseMovement then
			local x = i.Position - s
			f.Position = UDim2.new(p.X.Scale, p.X.Offset + x.X, p.Y.Scale, p.Y.Offset + x.Y)
		end
	end)
	
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then d = false end
	end)
end
coroutine.wrap(RXMTEB_fake_script)()
