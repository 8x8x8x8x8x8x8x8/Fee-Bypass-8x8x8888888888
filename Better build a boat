local function RTGXD_fake_script() -- Frame.LocalScript1 
	local script = Instance.new('LocalScript', Frame)

	local TS = game:GetService("TweenService")
	local RunService = game:GetService("RunService")
	local frame = script.Parent
	
	local finalPos = frame.Position
	local finalSize = frame.Size
	
	frame.Position = UDim2.new(0, 0, 0, 0)
	frame.Size = UDim2.new(0, 0, 0, 0)
	frame.BackgroundTransparency = 1 
	
	local enterInfo = TweenInfo.new(
		0.8,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out
	)
	
	TS:Create(frame, enterInfo, {
		Position = finalPos, 
		Size = finalSize, 
		BackgroundTransparency = 0
	}):Play()
	
	local stroke = frame:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	stroke.Parent = frame
	stroke.Thickness = 3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	
	local hue = 0
	RunService.RenderStepped:Connect(function(dt)
		hue = hue + (0.1 * dt)
		if hue > 1 then hue = 0 end
		stroke.Color = Color3.fromHSV(hue, 1, 1)
	end)
	
	local hoverInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	frame.MouseEnter:Connect(function()
		TS:Create(frame, hoverInfo, {
			Size = UDim2.new(finalSize.X.Scale * 1.05, finalSize.X.Offset, finalSize.Y.Scale * 1.05, finalSize.Y.Offset),
		}):Play()
		TS:Create(stroke, hoverInfo, {Thickness = 5}):Play()
	end)
	
	frame.MouseLeave:Connect(function()
		TS:Create(frame, hoverInfo, {
			Size = finalSize,
		}):Play()
		TS:Create(stroke, hoverInfo, {Thickness = 3}):Play()
	end)
end
coroutine.wrap(RTGXD_fake_script)()

