	BtnCorner.Parent = Btn

	local BtnStroke = Instance.new("UIStroke")
	BtnStroke.Color = Color3.fromRGB(50, 50, 60)
	BtnStroke.Thickness = 1
	BtnStroke.Parent = Btn
	
	local NameLabel = Instance.new("TextLabel")
	NameLabel.Name = "NameLabel"
	NameLabel.Size = UDim2.new(1, -80, 1, 0)
	NameLabel.Position = UDim2.new(0, 12, 0, 0)
	NameLabel.BackgroundTransparency = 1
	NameLabel.Font = Enum.Font.GothamSemibold
	NameLabel.Text = player.Name
	NameLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
	NameLabel.TextSize = 15
	NameLabel.TextXAlignment = Enum.TextXAlignment.Left
	NameLabel.Parent = Btn
	
	local StatusIcon = Instance.new("TextLabel")
	StatusIcon.Name = "StatusIcon"
	StatusIcon.Size = UDim2.new(0, 70, 1, 0)
	StatusIcon.Position = UDim2.new(1, -75, 0, 0)
	StatusIcon.BackgroundTransparency = 1
	StatusIcon.Font = Enum.Font.GothamBold
	StatusIcon.Text = "BAN"
	StatusIcon.TextColor3 = Color3.fromRGB(200, 50, 50)
	StatusIcon.TextSize = 14
	StatusIcon.Parent = Btn
	
	local function updateButtonVisual()
		if bannedPlayers[player] then
			Btn.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
			BtnStroke.Color = Color3.fromRGB(150, 30, 30)
			StatusIcon.Text = "BANNED"
			StatusIcon.TextColor3 = Color3.fromRGB(255, 80, 80)
			NameLabel.TextColor3 = Color3.fromRGB(180, 100, 100)
		else
			Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
			BtnStroke.Color = Color3.fromRGB(50, 50, 60)
			StatusIcon.Text = "BAN"
			StatusIcon.TextColor3 = Color3.fromRGB(200, 50, 50)
			NameLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
		end
	end
	
	Btn.MouseButton1Click:Connect(function()
		if bannedPlayers[player] then
			unbanPlayer(player)
		else
			banPlayer(player)
		end
		updateButtonVisual()
	end)
	
	playerButtons[player] = {button = Btn, updateVisual = updateButtonVisual}
	updateButtonVisual()
end

local function removePlayerButton(player)
	if playerButtons[player] then
		playerButtons[player].button:Destroy()
		playerButtons[player] = nil
	end
end

-- Initialize existing players
for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		createPlayerButton(player)
	end
end

-- Handle new players joining
Players.PlayerAdded:Connect(function(player)
	createPlayerButton(player)
end)

Players.PlayerRemoving:Connect(function(player)
	removePlayerButton(player)
	bannedPlayers[player] = nil
	updateStatus()
end)

-- ============================================================
-- MENU TOGGLE
-- ============================================================

local dragging = false
local dragStart = nil
local startPos = nil

-- Make main frame draggable
TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
	end
end)

TitleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Toggle menu visibility
local function toggleMenu()
	menuOpen = not menuOpen
	MainFrame.Visible = menuOpen
	if menuOpen then
		-- Animation: slide in
		MainFrame.Position = UDim2.new(0.5, -210, 0.5, -300)
		local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = game:GetService("TweenService"):Create(MainFrame, tweenInfo, {Position = UDim2.new(0.5, -210, 0.5, -260)})
		tween:Play()
	end
end

ToggleBtn.MouseButton1Click:Connect(toggleMenu)
CloseBtn.MouseButton1Click:Connect(toggleMenu)

-- Keyboard shortcut: Right Control to toggle
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.RightControl then
		toggleMenu()
	end
end)

-- ============================================================
-- CHAT MESSAGE HIDING (continuous check)
-- ============================================================

-- Periodically check for chat messages from banned players and hide them
task.spawn(function()
	while task.wait(1) do
		for player in pairs(bannedPlayers) do
			-- Hide any chat frames that contain this player's name
			for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
				if gui.Name == "Chat" or gui.Name == "BubbleChat" then
					for _, descendant in ipairs(gui:GetDescendants()) do
						if descendant:IsA("Frame") then
							-- Check if this frame is associated with the banned player
							local nameLabel = descendant:FindFirstChild("NameLabel", true) or descendant:FindFirstChild("Name", true)
							if nameLabel and nameLabel:IsA("TextLabel") and nameLabel.Text == player.Name then
								descendant.Visible = false
							end
						end
					end
				end
			end
			
			-- Re-hide character if it respawned
			if player.Character then
				for _, part in ipairs(player.Character:GetDescendants()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
						part.Transparency = 1
					end
				end
			end
			
			-- Hide from player list
			hidePlayerFromList(player)
		end
	end
end)

updateStatus()
