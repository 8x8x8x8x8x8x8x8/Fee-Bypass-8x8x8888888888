-- ============================================================
-- LOGIC
-- ============================================================

local function updateStatus()
	local count = 0
	for _ in pairs(bannedPlayers) do
		count = count + 1
	end
	StatusLabel.Text = count .. " player" .. (count == 1 and "" or "s") .. " banned"
end

local function hidePlayerFromChat(player)
	-- Hide from client chat by setting their chat visibility off
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
	end)
	-- Try to find chat messages from this player and hide them
	for _, descendant in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
		if descendant:IsA("Frame") or descendant:IsA("TextLabel") then
			if descendant.Name == player.Name or (descendant:FindFirstChild("Name") and descendant.Name:FindFirstChild("Name") and descendant.Name.Name.Text == player.Name) then
				descendant.Visible = false
		end
		end
	end
end

local function hidePlayerFromList(player)
	-- Hide from the player list (leaderboard) on the client
	pcall(function()
		-- The PlayerList core gui is not directly modifiable, but we can try
		-- by removing them from the client's view of the leaderboard
		local playerListFrame = LocalPlayer.PlayerGui:FindFirstChild("PlayerList", true)
		if playerListFrame then
			for _, descendant in ipairs(playerListFrame:GetDescendants()) do
				if descendant:IsA("Frame") and descendant.Name == player.Name then
					descendant.Visible = false
				end
			end
		end
	end)
end

local function banPlayer(player)
	if player == LocalPlayer then return end -- Don't ban yourself
	if bannedPlayers[player] then return end
	
	bannedPlayers[player] = true
	
	-- Hide character
	local function hideCharacter(character)
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
				part.Transparency = 1
			elseif part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
				part.Enabled = false
			elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
				part.Enabled = false
			end
		end
		-- Disable collisions
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanQuery = false
			end
		end
	end
	
	if player.Character then
		hideCharacter(player.Character)
	end
	
	player.CharacterAdded:Connect(function(char)
		if bannedPlayers[player] then
			task.wait(0.5)
			hideCharacter(char)
		end
	end)
	
	-- Hide from chat
	hidePlayerFromChat(player)
	
	-- Hide from player list
	hidePlayerFromList(player)
	
	-- Listen for chat messages and hide them
	local chatConnections = {}
	
	updateStatus()
end

local function unbanPlayer(player)
	if not bannedPlayers[player] then return end
	
	bannedPlayers[player] = nil
	
	-- Restore character
	local function showCharacter(character)
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				if part.Name == "HumanoidRootPart" then
					part.Transparency = 1
				else
					part.Transparency = 0
				end
				part.CanCollide = true
				part.CanQuery = true
			elseif part:IsA("Decal") or part:IsA("Texture") then
				part.Transparency = 0
			elseif part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
				part.Enabled = true
			elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
				part.Enabled = true
			end
		end
	end
	
	if player.Character then
		showCharacter(player.Character)
	end
	
	-- Restore in player list
	pcall(function()
		local playerListFrame = LocalPlayer.PlayerGui:FindFirstChild("PlayerList", true)
		if playerListFrame then
			for _, descendant in ipairs(playerListFrame:GetDescendants()) do
				if descendant:IsA("Frame") and descendant.Name == player.Name then
					descendant.Visible = true
				end
			end
		end
	end)
	
	updateStatus()
end

