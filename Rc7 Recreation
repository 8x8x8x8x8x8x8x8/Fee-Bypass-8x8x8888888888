		function P.parseChunk() local body = parseBlock(); if peek().tp ~= "eof" then fail("unexpected '" .. tostring(peek().v) .. "'") end; return body end
		function P.parseExpression() local e = parseExpr(); if peek().tp ~= "eof" then fail("unexpected '" .. tostring(peek().v) .. "'") end; return e end
		return P
	end
	
	----------------------------------------------------------------
	-- EVALUATOR
	----------------------------------------------------------------
	local E, S = {}, {}
	local execBlock, doCall
	local function rtError(msg) error(msg, 0) end
	local function newScope(parent) return { vars = {}, parent = parent, env = parent.env, st = parent.st } end
	local function lookup(scope, name)
		local s = scope
		while s do
			local v = s.vars[name]
			if v ~= nil then if v == NIL then return nil end; return v end
			s = s.parent
		end
		return scope.env[name]
	end
	local function assignVar(scope, name, value)
		local s = scope
		while s do
			if s.vars[name] ~= nil then if value == nil then s.vars[name] = NIL else s.vars[name] = value end; return end
			s = s.parent
		end
		scope.env[name] = value
	end
	local function declare(scope, name, value) if value == nil then scope.vars[name] = NIL else scope.vars[name] = value end end
	local function getVarargs(scope)
		local s = scope
		while s do
			local v = s.vars["..."]
			if v then return v end
			s = s.parent
		end
		rtError("cannot use '...' outside a vararg function")
	end
	local function step(st)
		if st.stop then error("Execution stopped", 0) end
		local c = st.steps + 1
		st.steps = c
		if c % 256 == 0 then
			local now = os.clock()
			if now - st.last > 0.012 then pcall(st.yield); st.last = os.clock() end
		end
	end
	local function eval(n, scope) return (E[n.t](n, scope)) end
	local function evalList(exprs, scope)
		local count = #exprs
		local out = { n = 0 }
		for i = 1, count do
			local e = exprs[i]
			if i == count and (e.t == "Call" or e.t == "MethodCall" or e.t == "Vararg") then
				local r
				if e.t == "Vararg" then r = getVarargs(scope) else r = table.pack(doCall(e, scope)) end
				local base = out.n
				for j = 1, r.n do out[base + j] = r[j] end
				out.n = base + r.n
			else
				local v = eval(e, scope); out.n = out.n + 1; out[out.n] = v
			end
		end
		return out
	end
	
	doCall = function(n, scope)
		local fn, args
		if n.t == "MethodCall" then
			local self = eval(n.obj, scope); fn = self[n.name]; args = evalList(n.args, scope)
			local tf = type(fn)
			if tf ~= "function" and tf ~= "table" and tf ~= "userdata" then rtError("attempt to call a " .. typeOf(fn) .. " value") end
			return fn(self, table.unpack(args, 1, args.n))
		end
		fn = eval(n.fn, scope); args = evalList(n.args, scope)
		local tf = type(fn)
		if tf ~= "function" and tf ~= "table" and tf ~= "userdata" then rtError("attempt to call a " .. typeOf(fn) .. " value") end
		return fn(table.unpack(args, 1, args.n))
	end
	
	local BIN = {
		["+"] = function(a, b) return a + b end, ["-"] = function(a, b) return a - b end, ["*"] = function(a, b) return a * b end, ["/"] = function(a, b) return a / b end,
		["//"] = function(a, b) return a // b end, ["%"] = function(a, b) return a % b end, ["^"] = function(a, b) return a ^ b end, [".."] = function(a, b) return a .. b end,
		["=="] = function(a, b) return a == b end, ["~="] = function(a, b) return a ~= b end, ["<"] = function(a, b) return a < b end, ["<="] = function(a, b) return a <= b end,
		[">"] = function(a, b) return a > b end, [">="] = function(a, b) return a >= b end,
	}
	
	E.Const = function(n) return n.v end
	E.Name = function(n, scope) return lookup(scope, n.name) end
	E.Vararg = function(n, scope) return getVarargs(scope)[1] end
	E.Paren = function(n, scope) return eval(n.e, scope) end
	E.Index = function(n, scope) local obj = eval(n.obj, scope); local key = eval(n.key, scope); return obj[key] end
	E.Call = function(n, scope) return (doCall(n, scope)) end
	E.MethodCall = E.Call
	E.Binop = function(n, scope)
		local op = n.op
		if op == "and" then local a = eval(n.a, scope); if not a then return a end; return eval(n.b, scope)
		elseif op == "or" then local a = eval(n.a, scope); if a then return a end; return eval(n.b, scope) end
		local a = eval(n.a, scope); local b = eval(n.b, scope); return BIN[op](a, b)
	end
	E.Unop = function(n, scope)
		local a = eval(n.e, scope)
		if n.op == "not" then return not a elseif n.op == "-" then return -a else return #a end
	end
	E.IfExp = function(n, scope) if eval(n.cond, scope) then return eval(n.a, scope) end; return eval(n.b, scope) end
	E.Interp = function(n, scope)
		local buf = {}
		for i, p in ipairs(n.parts) do buf[i] = tostring(eval(p, scope)) end
		return table.concat(buf)
	end
	E.Table = function(n, scope)
		local t = {}
		local items = n.items
		local count = #items
		local idx = 0
		for i = 1, count do
			local it = items[i]
			if it.k then local k = eval(it.k, scope); if k == nil then rtError("table index is nil") end; t[k] = eval(it.v, scope)
			else
				local v = it.v
				if i == count and (v.t == "Call" or v.t == "MethodCall" or v.t == "Vararg") then
					local r
					if v.t == "Vararg" then r = getVarargs(scope) else r = table.pack(doCall(v, scope)) end
					for j = 1, r.n do t[idx + j] = r[j] end; idx = idx + r.n
				else idx = idx + 1; t[idx] = eval(v, scope) end
			end
		end
		return t
	end
	E.Function = function(n, scope)
		local params, np, vararg, body = n.params, #n.params, n.vararg, n.body
		return function(...)
			local st = scope.st
			if st.stop then error("Execution stopped", 0) end
			local fs = newScope(scope)
			local vars = fs.vars
			local args = table.pack(...)
			for i = 1, np do local v = args[i]; if v == nil then vars[params[i]] = NIL else vars[params[i]] = v end end
			if vararg then vars["..."] = table.pack(select(np + 1, ...)) end
			local sig, vals = execBlock(body, fs)
			if sig == "return" then return table.unpack(vals, 1, vals.n) end
		end
	end
	
	execBlock = function(stmts, scope)
		for i = 1, #stmts do
			local s = stmts[i]
			scope.st.line = s.line
			local sig, vals = S[s.t](s, scope)
			if sig then return sig, vals end
		end
	end
	
	S = {}
	S.ExprStat = function(n, scope) doCall(n.e, scope) end
	S.Local = function(n, scope)
		local vals = evalList(n.exprs, scope)
		local names = n.names
		for i = 1, #names do declare(scope, names[i], vals[i]) end
	end
	S.LocalFunction = function(n, scope)
		declare(scope, n.name, nil)
		scope.vars[n.name] = E.Function(n.fn, scope)
	end
	S.Assign = function(n, scope)
		local vals = evalList(n.exprs, scope)
		local targets = n.targets
		for i = 1, #targets do
			local tg = targets[i]
			local v = vals[i]
			if tg.t == "Name" then assignVar(scope, tg.name, v)
			else local obj = eval(tg.obj, scope); local key = eval(tg.key, scope); obj[key] = v end
		end
	end
	S.Compound = function(n, scope)
		local tg = n.target
		local op = BIN[n.op]
		if tg.t == "Name" then
			local cur = lookup(scope, tg.name)
			assignVar(scope, tg.name, op(cur, eval(n.e, scope)))
		else
			local obj = eval(tg.obj, scope); local key = eval(tg.key, scope); obj[key] = op(obj[key], eval(n.e, scope))
		end
	end
	S.If = function(n, scope)
		local clauses = n.clauses
		for i = 1, #clauses do
			local c = clauses[i]
			if eval(c.cond, scope) then return execBlock(c.body, newScope(scope)) end
		end
		if n.elseBody then return execBlock(n.elseBody, newScope(scope)) end
	end
	S.Do = function(n, scope) return execBlock(n.body, newScope(scope)) end
	S.While = function(n, scope)
		local st = scope.st
		while eval(n.cond, scope) do
			step(st)
			local sig, vals = execBlock(n.body, newScope(scope))
			if sig == "break" then break elseif sig == "return" then return sig, vals end
		end
	end
	S.Repeat = function(n, scope)
		local st = scope.st
		while true do
			step(st)
			local bs = newScope(scope)
			local sig, vals = execBlock(n.body, bs)
			if sig == "break" then break elseif sig == "return" then return sig, vals end
			if eval(n.cond, bs) then break end
		end
	end
	S.NumFor = function(n, scope)
		local st = scope.st
		local a, b = eval(n.start, scope), eval(n.limit, scope)
		local c = 1
		if n.step then c = eval(n.step, scope) end
		for i = a, b, c do
			step(st)
			local ls = newScope(scope)
			ls.vars[n.var] = i
			local sig, vals = execBlock(n.body, ls)
			if sig == "break" then break elseif sig == "return" then return sig, vals end
		end
	end
	S.GenFor = function(n, scope)
		local st = scope.st
		local vals = evalList(n.exprs, scope)
		local f, s, c = vals[1], vals[2], vals[3]
		if type(f) == "table" then
			local mt = getmetatable(f)
			if not (type(mt) == "table" and mt.__call) then f, s, c = next, f, nil end
		end
		if f == nil then rtError("attempt to iterate over a nil value") end
		local names, nn = n.names, #n.names
		while true do
			step(st)
			local r = table.pack(f(s, c))
			local first = r[1]
			if first == nil then break end
			c = first
			local ls = newScope(scope)
			for i = 1, nn do local v = r[i]; if v == nil then ls.vars[names[i]] = NIL else ls.vars[names[i]] = v end end
			local sig, rv = execBlock(n.body, ls)
			if sig == "break" then break elseif sig == "return" then return sig, rv end
		end
	end
	S.Return = function(n, scope) return "return", evalList(n.exprs, scope) end
	S.Break = function() return "break" end
	S.Continue = function() return "continue" end
	
	function Interp.load(src, env, st)
		local ok, ast = pcall(function() return newParser(tokenize(src)).parseChunk() end)
		if not ok then return nil, tostring(ast) end
		return function(...)
			local scope = { vars = {}, env = env, st = st }
			scope.vars["..."] = table.pack(...)
			local sig, vals = execBlock(ast, scope)
			if sig == "return" then return table.unpack(vals, 1, vals.n) end
		end
	end
	
	function Interp.createEnv(st, out)
		local env = {}
		env.print = function(...)
			local parts = {}
			for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
			out(table.concat(parts, "\t"), "print")
		end
		env.warn = function(...)
			local parts = {}
			for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
			out(table.concat(parts, " "), "warn")
		end
		env.type = type; env.typeof = typeOf; env.tostring = tostring; env.tonumber = tonumber
		env.pairs = pairs; env.ipairs = ipairs; env.next = next; env.select = select; env.unpack = table.unpack
		env.rawget, env.rawset, env.rawequal, env.rawlen = rawget, rawset, rawequal, rawlen
		env.setmetatable, env.getmetatable = setmetatable, getmetatable
		env.assert = assert; env.xpcall = xpcall
