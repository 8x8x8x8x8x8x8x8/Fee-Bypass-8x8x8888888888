		env.pcall = function(f, ...)
			local r = table.pack(pcall(f, ...))
			if not r[1] and type(r[2]) == "string" then r[2] = (r[2]:gsub("^[^:\n]*[Ii]nterp[^:\n]*:%d+: ", "", 1)) end
			return table.unpack(r, 1, r.n)
		end
		env.math = math; env.string = string; env.table = table; env.coroutine = coroutine
		if utf8 then env.utf8 = utf8 end
		if bit32 then env.bit32 = bit32 end
		env.os = { time = os.time, clock = os.clock, date = os.date, difftime = os.difftime }
		env.game, env.workspace, env.shared = game, workspace, shared
		env.task, env.tick, env.time, env.wait = task, tick, time, wait
		env.Instance, env.Enum = Instance, Enum
		env.Vector2, env.Vector3, env.Vector2int16, env.Vector3int16 = Vector2, Vector3, Vector2int16, Vector3int16
		env.CFrame, env.Color3, env.BrickColor = CFrame, Color3, BrickColor
		env.UDim, env.UDim2, env.Rect, env.Ray, env.Region3 = UDim, UDim2, Rect, Ray, Region3
		env.TweenInfo, env.Random, env.Font, env.DateTime = TweenInfo, Random, Font, DateTime
		env.NumberRange, env.NumberSequence, env.NumberSequenceKeypoint = NumberRange, NumberSequence, NumberSequenceKeypoint
		env.ColorSequence, env.ColorSequenceKeypoint = ColorSequence, ColorSequenceKeypoint
		env.PhysicalProperties = PhysicalProperties
		env._G = env
		env.loadstring = function(src)
			if type(src) ~= "string" then error("bad argument #1 to 'loadstring' (string expected)") end
			local fn, err = Interp.load(src, env, st)
			if not fn then return nil, err end
			return fn
		end
		return env
	end
	
	----------------------------------------------------------------
	-- EXECUTION LOGIC
	----------------------------------------------------------------
	local function executeCode()
		local codeToRun = ScriptBox.Text
		if codeToRun == "" then return end
	
		local st = {
			line = 0,
			steps = 0,
			stop = false,
			last = os.clock(),
			yield = task.wait, 
		}
	
		local env = Interp.createEnv(st, function(text, kind)
			if kind == "warn" then warn(text) else print(text) end
		end)
	
		local fn, err = Interp.load(codeToRun, env, st)
	
		if fn then
			task.spawn(function()
				pcall(fn)
			end)
		end
	end
	
	ExecuteButton.MouseButton1Click:Connect(executeCode)
end
