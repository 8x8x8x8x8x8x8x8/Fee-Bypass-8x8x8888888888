--==================================================
-- PART CONTROL
--==================================================

local parts = {}

local function addPart(part)

    if not part:IsA("BasePart") then
        return
    end

    if part.Anchored then
        return
    end

    if part:IsDescendantOf(LocalPlayer.Character or Instance.new("Folder")) then
        return
    end

    if part.Parent and part.Parent:FindFirstChildOfClass("Humanoid") then
        return
    end

    if part.Name == "Handle" then
        return
    end

    if not table.find(parts, part) then

        table.insert(parts, part)

        pcall(function()
            part.CustomPhysicalProperties =
                PhysicalProperties.new(0, 0, 0, 0, 0)

            part.CanCollide = false
        end)

    end

end

local function removePart(part)

    local index = table.find(parts, part)

    if index then
        table.remove(parts, index)
    end

end

for _, part in ipairs(Workspace:GetDescendants()) do
    addPart(part)
end

Workspace.DescendantAdded:Connect(function(part)
    task.wait()
    addPart(part)
end)

Workspace.DescendantRemoving:Connect(removePart)

--==================================================
-- TORNADO LOOP
--==================================================

RunService.Heartbeat:Connect(function()

    if not tornadoEnabled then
        return
    end

    if not selectedPlayer then
        return
    end

    local character = selectedPlayer.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    local center = root.Position

    for _, part in ipairs(parts) do

        if part and part.Parent and not part.Anchored then

            local pos = part.Position

            local flatPosition =
                Vector3.new(
                    pos.X,
                    center.Y,
                    pos.Z
                )

            local distance =
                (flatPosition - center).Magnitude

            if distance <= config.radius then

                local angle =
                    math.atan2(
                        pos.Z - center.Z,
                        pos.X - center.X
                    )

                local newAngle =
                    angle + math.rad(config.rotationSpeed)

                local heightOffset = 0

                if config.height > 0 then

                    heightOffset =
                        config.height *
                        math.abs(
                            math.sin(
                                (pos.Y - center.Y)
                                / config.height
                            )
                        )

                end

                local targetPosition =
                    Vector3.new(
                        center.X +
                            math.cos(newAngle) *
                            math.min(
                                config.radius,
                                math.max(distance, 1)
                            ),

                        center.Y + heightOffset,

                        center.Z +
                            math.sin(newAngle) *
                            math.min(
                                config.radius,
                                math.max(distance, 1)
                            )
                    )

                local direction =
                    targetPosition - part.Position

                if direction.Magnitude > 0 then

                    pcall(function()

                        part.Velocity =
                            direction.Unit *
                            config.attractionStrength

                    end)

                end

            else

                -- Pull distant parts toward the selected player
                local direction =
                    center - part.Position

                if direction.Magnitude > 0 then

                    pcall(function()

                        part.Velocity =
                            direction.Unit *
                            config.attractionStrength

                    end)

                end

            end
        end
    end
end)

--==================================================
-- DRAG GUI
--==================================================

local dragging = false
local dragStart
local startPosition

Title.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        dragging = true

        dragStart = input.Position
        startPosition = MainFrame.Position

        input.Changed:Connect(function()

            if input.UserInputState ==
                Enum.UserInputState.End then

                dragging = false

            end

        end)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if dragging and
        input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local delta =
            input.Position - dragStart

        MainFrame.Position =
            UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,

                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )

    end

end)

--==================================================
-- K TOGGLE
--==================================================

UserInputService.InputBegan:Connect(function(input, processed)

    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.K then

        ScreenGui.Enabled =
            not ScreenGui.Enabled

    end

end)
