local function QYTODBJ_fake_script() -- Frame.LocalScript 
	local script = Instance.new('LocalScript', Frame)

	local Players = game:GetService("Players")
	
	local gui = script.Parent
	local frame = gui:WaitForChild("Frame")
	local dropdownButton = frame:WaitForChild("DropdownButton")
	
	dropdownButton.Text = "Select Player ▼"
	
	-- Create the player list
	local playerList = Instance.new("ScrollingFrame")
	playerList.Name = "PlayerList"
	playerList.Size = UDim2.new(1, 0, 0, 200)
	playerList.Position = UDim2.new(0, 0, 1, 5)
	playerList.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	playerList.Visible = false
	playerList.ScrollBarThickness = 6
	playerList.Parent = frame
	
	local layout = Instance.new("UIListLayout")
	layout.Parent = playerList
	layout.Padding = UDim.new(0, 2)
	
	local function updatePlayers()
		for _, object in ipairs(playerList:GetChildren()) do
			if object:IsA("TextButton") then
				object:Destroy()
			end
		end
	
		for _, target in ipairs(Players:GetPlayers()) do
			local button = Instance.new("TextButton")
	
			button.Size = UDim2.new(1, -10, 0, 35)
			button.Text = target.Name
			button.TextColor3 = Color3.new(1, 1, 1)
			button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			button.Parent = playerList
	
			button.MouseButton1Click:Connect(function()
				dropdownButton.Text = target.Name
				playerList.Visible = false
			end)
		end
	
		playerList.CanvasSize = UDim2.new(
			0,
			0,
			0,
			layout.AbsoluteContentSize.Y + 10
		)
	end
	
	dropdownButton.MouseButton1Click:Connect(function()
		playerList.Visible = not playerList.Visible
	
		if playerList.Visible then
			updatePlayers()
		end
	end)
	
	Players.PlayerAdded:Connect(updatePlayers)
	Players.PlayerRemoving:Connect(updatePlayers)
	
	updatePlayers()
end
coroutine.wrap(QYTODBJ_fake_script)()
