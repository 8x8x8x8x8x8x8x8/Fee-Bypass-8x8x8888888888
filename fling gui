local function KKRW_fake_script() -- TextButton.LocalScript 
	local script = Instance.new('LocalScript', TextButton)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local StarterGui = game:GetService("StarterGui")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	local gui = button.Parent
	local textBox = gui:WaitForChild("TextBox")
	
	local function notify(title, text)
		StarterGui:SetCore("SendNotification", {
			Title = title;
			Text = text;
			Duration = 3;
		})
	end
	
	local function findTarget(name)
		name = name:lower()
	
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Name:lower():sub(1, #name) == name then
				return p
			end
		end
	
		return nil
	end
	
	button.MouseButton1Click:Connect(function()
		local target = findTarget(textBox.Text)
	
		if not target then
			notify("Player Not Found", "Couldn't find that player.")
			return
		end
	
		local character = player.Character
		local targetCharacter = target.Character
	
		if not character or not targetCharacter then
			notify("Error", "Character not found.")
			return
		end
	
		local root = character:FindFirstChild("HumanoidRootPart")
		local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	
		if not root or not targetRoot then
			notify("Error", "HumanoidRootPart not found.")
			return
		end
	
		-- Save your original position
		local originalCFrame = root.CFrame
	
		notify("Fling", "Starting test on " .. target.Name)
	
		local thrust = Instance.new("BodyThrust")
		thrust.Name = "LocalTestThrust"
		thrust.Force = Vector3.new(9999, 9999, 9999)
		thrust.Location = targetRoot.Position
		thrust.Parent = root
	
		local start = os.clock()
	
		while os.clock() - start < 3 do
			if not root.Parent or not targetRoot.Parent then
				break
			end
	
			root.CFrame = targetRoot.CFrame
			thrust.Location = targetRoot.Position
	
			RunService.Heartbeat:Wait()
		end
	
		thrust:Destroy()
	
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	
		-- Return to where you started
		root.CFrame = originalCFrame
	
		notify("Fling", "Finished! Returned to starting position.")
	end)
end
coroutine.wrap(KKRW_fake_script)()
local function XWOJQR_fake_script() -- Frame.Draggable 
	local script = Instance.new('LocalScript', Frame)

	local UIS = game:GetService("UserInputService")
	local f = script.Parent
	local d, s, p
	
	f.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			d, s, p = true, i.Position, f.Position
		end
	end)
	
	UIS.InputChanged:Connect(function(i)
		if d and i.UserInputType == Enum.UserInputType.MouseMovement then
			local x = i.Position - s
			f.Position = UDim2.new(p.X.Scale, p.X.Offset + x.X, p.Y.Scale, p.Y.Offset + x.Y)
		end
	end)
	
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then d = false end
	end)
end
coroutine.wrap(XWOJQR_fake_script)()
