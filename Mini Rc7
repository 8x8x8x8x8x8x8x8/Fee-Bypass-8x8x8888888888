local function DCFCWJE_fake_script() -- Frame.Draggable 
	local script = Instance.new('LocalScript', Frame)

	local UIS = game:GetService("UserInputService")
	local f = script.Parent
	local d, s, p
	
	f.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			d, s, p = true, i.Position, f.Position
		end
	end)
	
	UIS.InputChanged:Connect(function(i)
		if d and i.UserInputType == Enum.UserInputType.MouseMovement then
			local x = i.Position - s
			f.Position = UDim2.new(p.X.Scale, p.X.Offset + x.X, p.Y.Scale, p.Y.Offset + x.Y)
		end
	end)
	
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then d = false end
	end)
end
coroutine.wrap(DCFCWJE_fake_script)()
local function AVBNXPX_fake_script() -- Open.LocalScript 
	local script = Instance.new('LocalScript', Open)

	-- This script must be a LocalScript placed INSIDE the button
	local button = script.Parent
	local StarterGui = game:GetService("StarterGui")
	
	-- The logic: When the button is clicked
	button.MouseButton1Click:Connect(function()
	
		-- We use a 'pcall' (protected call) because SetCore can sometimes 
		-- fail if the game hasn't fully loaded the system UI yet.
		local success, err = pcall(function()
			StarterGui:SetCore("SendNotification", {
				Title = "Connection Error", -- The bold header
				Text = "Unable to connect",   -- The message below the header
				Duration = 5,                -- How many seconds it stays on screen
				Button1 = "OK"               -- Optional: Adds a button to the notification
			})
		end)
	
		if not success then
			warn("Notification failed to send: " .. err)
		end
	end)
end
coroutine.wrap(AVBNXPX_fake_script)()
local function WMUVYI_fake_script() -- RunButton.LocalScript 
	local script = Instance.new('LocalScript', RunButton)

	-- ALL-IN-ONE CLIENT SCRIPT (For Executors)
	local runButton = script.Parent
	
	-- Pathing: Find the ScriptBox inside the ScrollingFrame
	-- This assumes the RunButton and ScrollingFrame are siblings (both inside the same Frame)
	local scrollingFrame = runButton.Parent:WaitForChild("ScrollingFrame")
	local scriptBox = scrollingFrame:WaitForChild("ScriptBox")
	
	runButton.MouseButton1Click:Connect(function()
		local code = scriptBox.Text
	
		-- We use pcall so that if the code has an error, 
		-- the button script doesn't crash and can be used again.
		local success, err = pcall(function()
			-- loadstring converts the text into a function and () runs it immediately
			local func = loadstring(code)
			if func then
				func()
			else
				error("Failed to compile code. Check for syntax errors.")
			end
		end)
	
		if not success then
			warn("Execution Error: " .. tostring(err))
		end
	end)
end
coroutine.wrap(WMUVYI_fake_script)()
