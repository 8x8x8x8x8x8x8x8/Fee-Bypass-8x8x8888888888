local function QCNXZMI_fake_script() -- Frame.LocalScript 
	local script = Instance.new('LocalScript', Frame)

	local UserInputService = game:GetService("UserInputService")
	local frame = script.Parent -- This assumes the script is INSIDE the frame
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		-- Prevents the GUI from toggling while you are typing in chat
		if gameProcessed then return end
	
		if input.KeyCode == Enum.KeyCode.RightShift then
			frame.Visible = not frame.Visible
		end
	end)
end
coroutine.wrap(QCNXZMI_fake_script)()
