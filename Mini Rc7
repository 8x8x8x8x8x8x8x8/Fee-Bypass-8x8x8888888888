local function YTJSXBD_fake_script() -- Copy.LocalScript 
	local script = Instance.new('LocalScript', Copy)

	local copyButton = script.Parent
	
	-- Pathing: Find the ScriptBox inside the ScrollingFrame
	local scrollingFrame = copyButton.Parent:WaitForChild("ScrollingFrame")
	local scriptBox = scrollingFrame:WaitForChild("ScriptBox")
	
	copyButton.MouseButton1Click:Connect(function()
		local textToCopy = scriptBox.Text
	
		if textToCopy == "" then
			print("Nothing to copy!")
			return
		end
	
		-- Use the Executor's clipboard function
		-- Most executors use setclipboard, some use toclipboard
		if setclipboard then
			setclipboard(textToCopy)
		elseif toclipboard then
			toclipboard(textToCopy)
		else
			warn("Your executor does not support clipboard functions!")
			return
		end
	
		-- VISUAL FEEDBACK: Change button text temporarily
		local originalText = copyButton.Text
		copyButton.Text = "Copied!"
		copyButton.TextColor3 = Color3.fromRGB(0, 255, 0) -- Green
	
		task.wait(1) -- Wait 1 second
	
		copyButton.Text = originalText
		copyButton.TextColor3 = Color3.fromRGB(255, 255, 255) -- Back to white
	end)
end
coroutine.wrap(YTJSXBD_fake_script)()
