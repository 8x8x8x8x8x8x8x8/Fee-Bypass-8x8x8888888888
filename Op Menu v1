				plr.CharacterAdded:Connect(function(Char)
					RunCustomAnimation(Char)
				end)
				local targetScript = button.Parent:FindFirstChild("MyLocalScript")
	
				if targetScript then
					targetScript.Enabled = true
				end
			end)
		end
	
